# Resend API key used by the contact form endpoint
RESEND_API_KEY=

# Verified sender email in Resend (or keep onboarding@resend.dev for initial testing)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional override for receiver address (defaults to your@email.com)
CONTACT_TO_EMAIL=your@email.com

# Optional anti-spam throttle for contact endpoint
# Max POSTs per IP inside window (defaults to 5)
CONTACT_RATE_LIMIT_MAX=5
# Sliding window in milliseconds (defaults to 600000 = 10 minutes)
CONTACT_RATE_LIMIT_WINDOW_MS=600000
