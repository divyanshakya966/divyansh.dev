{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"compatibility_date": "2025-09-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"routes": [
		{
			"pattern": "divyansh.dev.gohack.xyz",
			"zone_name": "gohack.xyz",
			"custom_domain": true,
		},
	],
	"vars": {
		"CONTACT_RATE_LIMIT_MAX": "5",
		"CONTACT_RATE_LIMIT_WINDOW_MS": "600000"
	},
	// Workers Logs in dashboard + `wrangler tail`, matching local console output.
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	// D1 over the `DB` binding (no connection strings).
	// Keep "binding" as "DB" — server.ts reads env.DB (wrangler auto-inserts
	// "portfolio_db" on `d1 create`; rename it back). See docs/ADMIN_SETUP.md.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio-db",
			"database_id": "39e28a4a-591e-4474-b7b6-c6f0033fd03b",
			"remote": true
		}
	]
}