{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"compatibility_date": "2025-09-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"routes": [
		{
			"pattern": "divyansh.dev.gohack.xyz",
			"zone_name": "gohack.xyz",
			"custom_domain": true,
		},
	],
	"vars": {
		"CONTACT_RATE_LIMIT_MAX": "5",
		"CONTACT_RATE_LIMIT_WINDOW_MS": "600000"
	},
	// Workers Logs: collect console output + per-invocation records so
	// `wrangler tail` and the dashboard show the same logs locally and in
	// production (auth errors, Resend failures, crypto issues).
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	// External managed DB for admin auth + dynamic content (no connection
	// strings — Workers talk to D1 over the `DB` binding).
	// IMPORTANT: keep "binding" as "DB" — server.ts reads env.DB.
	// `wrangler d1 create` auto-inserts "portfolio_db" here; rename it back.
	// Setup: npx wrangler d1 create portfolio-db  -> paste database_id below
	//        npx wrangler d1 migrations apply portfolio-db --local
	//        npx wrangler d1 migrations apply portfolio-db --remote
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio-db",
			"database_id": "39e28a4a-591e-4474-b7b6-c6f0033fd03b",
			"remote": true
		}
	]
}