# Copy this file to `.dev.vars` and fill in real values for local development.
# The Cloudflare Vite plugin reads `.dev.vars` for local `bun run dev` runs.
# Never commit the real `.dev.vars` (it is gitignored).

# Required for the contact form to work (server returns 500 without these).
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Must be a sender address verified in your Resend account (e.g. no-reply@divyansh.dev).
# The dev fallback `onboarding@resend.dev` only works for deliveries to your own inbox.
RESEND_FROM_EMAIL=

# Optional — where contact messages are delivered.
CONTACT_TO_EMAIL=

# Optional — rate limiting (defaults match wrangler.jsonc: 5 requests / 10 min).
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000